{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgedculture.org/das-1/schemas/receipt.schema.json",
  "title": "DAS-1 Receipt Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "event_id",
    "timestamp",
    "actor_id",
    "workflow_id",
    "tool",
    "action",
    "risk_class",
    "decision",
    "policy_version",
    "correlation_id",
    "inputs_present",
    "outputs_present"
  ],
  "properties": {
    "receipt_version": {"type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$"},
    "event_id": {"type": "string", "minLength": 8},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "minLength": 1},
    "owner_id": {"type": "string"},
    "workflow_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "target": {"type": "string"},
    "risk_class": {"type": "string", "enum": ["R1", "R2", "R3", "R4"]},
    "decision": {"type": "string", "enum": ["allow", "deny"]},
    "deny_reason": {"type": "string"},
    "policy_version": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string"},
    "span_id": {"type": "string"},
    "inputs_present": {"type": "boolean"},
    "outputs_present": {"type": "boolean"},
    "inputs_hash": {"type": "string"},
    "outputs_hash": {"type": "string"},
    "data_classes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "approver_id": {"type": "string"},
    "approval_id": {"type": "string"},
    "approval_required": {"type": "boolean"},
    "approval_wait_ms": {"type": "number", "minimum": 0},
    "preflight_id": {"type": "string"},
    "execution_status": {
      "type": "string",
      "enum": ["executed", "blocked", "queued", "failed", "noop"]
    },
    "execution_latency_ms": {"type": "number", "minimum": 0},
    "cost_center": {"type": "string"},
    "cost_estimate": {"type": "number", "minimum": 0},
    "cost_actual": {"type": "number", "minimum": 0},
    "cap_id": {"type": "string"},
    "revoked": {"type": "boolean"},
    "revoke_of_event_id": {"type": "string"},
    "cap_enforced": {"type": "boolean"},
    "cap_enforcement_point": {"type": "string", "enum": ["execution_path", "reporting_layer"]},
    "delegation_id": {"type": "string", "minLength": 1},
    "parent_actor_id": {"type": "string", "minLength": 1},
    "delegation_depth": {"type": "integer", "minimum": 0},
    "root_principal_id": {"type": "string", "minLength": 1},
    "granted_risk_ceiling": {"type": "string", "enum": ["R1", "R2", "R3", "R4"]},
    "autonomy_level": {"type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "A5"]},
    "composition_group_id": {"type": "string", "minLength": 1},
    "composed_class": {"type": "string", "enum": ["R1", "R2", "R3", "R4"]},
    "classification_ref": {"type": "string", "minLength": 1},
    "overlay_context": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "notes": {"type": "string"}
  }
}
