{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgedculture.org/das-1/schemas/receipt.schema.json",
  "title": "DAS-1 Receipt Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "event_id",
    "timestamp",
    "actor_id",
    "workflow_id",
    "tool",
    "action",
    "risk_class",
    "decision",
    "policy_version",
    "correlation_id",
    "inputs_present",
    "outputs_present"
  ],
  "properties": {
    "receipt_version": {"type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$"},
    "event_id": {"type": "string", "minLength": 8},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "minLength": 1},
    "owner_id": {"type": "string"},
    "workflow_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "target": {"type": "string"},
    "risk_class": {"type": "string", "enum": ["R1", "R2", "R3", "R4"]},
    "decision": {"type": "string", "enum": ["allow", "deny"]},
    "deny_reason": {"type": "string"},
    "policy_version": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string"},
    "span_id": {"type": "string"},
    "inputs_present": {"type": "boolean"},
    "outputs_present": {"type": "boolean"},
    "inputs_hash": {"type": "string"},
    "outputs_hash": {"type": "string"},
    "data_classes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "approver_id": {"type": "string"},
    "approval_id": {"type": "string"},
    "preflight_id": {"type": "string"},
    "cost_center": {"type": "string"},
    "cost_estimate": {"type": "number", "minimum": 0},
    "cost_actual": {"type": "number", "minimum": 0},
    "cap_id": {"type": "string"},
    "revoked": {"type": "boolean"},
    "revoke_of_event_id": {"type": "string"},
    "notes": {"type": "string"}
  }
}
