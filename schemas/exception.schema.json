{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgedculture.org/das-1/schemas/exception.schema.json",
  "title": "DAS-1 Exceptions Register Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exception_id",
    "created_at",
    "expires_at",
    "owner_id",
    "control_ids",
    "justification",
    "status"
  ],
  "properties": {
    "exception_id": {
      "type": "string",
      "minLength": 8
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "control_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^AEC-\\d{2}$"
      }
    },
    "risk_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "R1",
          "R2",
          "R3",
          "R4"
        ]
      }
    },
    "justification": {
      "type": "string",
      "minLength": 10
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "active",
        "expired",
        "revoked",
        "denied"
      ]
    },
    "ticket": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "mitigation": {
      "type": "string"
    },
    "ticket_ref": {
      "type": "string"
    }
  }
}