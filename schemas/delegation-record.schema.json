{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgedculture.org/das-1/schemas/delegation-record.schema.json",
  "title": "DAS-1 Delegation Record",
  "description": "AEC-13 receipt. One record per delegation, naming the delegating agent, the delegated agent, the granted scope, the granted risk ceiling, and an expiry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "delegation_id",
    "issued_at",
    "delegating_actor_id",
    "delegated_actor_id",
    "granted_scope",
    "granted_risk_ceiling",
    "granted_autonomy_level",
    "expires_at",
    "root_principal_id",
    "revocation_path",
    "status"
  ],
  "properties": {
    "record_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "delegation_id": {
      "type": "string",
      "minLength": 8
    },
    "parent_delegation_id": {
      "type": "string",
      "minLength": 8,
      "description": "The delegation this one descends from. Absent at depth 0, where the delegating agent holds authority directly from the human principal."
    },
    "delegation_depth": {
      "type": "integer",
      "minimum": 0
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "delegating_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "delegated_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "root_principal_id": {
      "type": "string",
      "minLength": 1,
      "description": "The human principal at the root of the delegation lineage."
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "granted_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "data_classes"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "data_classes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "delegating_scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "The delegating agent's own authority at time of grant. Present so the AEC-13 subset rule is checkable from the record alone.",
      "required": [
        "tools",
        "data_classes",
        "risk_ceiling",
        "autonomy_level"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "data_classes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "risk_ceiling": {
          "type": "string",
          "enum": ["R1", "R2", "R3", "R4"]
        },
        "autonomy_level": {
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3", "A4", "A5"]
        }
      }
    },
    "granted_risk_ceiling": {
      "type": "string",
      "enum": ["R1", "R2", "R3", "R4"]
    },
    "granted_autonomy_level": {
      "type": "string",
      "enum": ["A0", "A1", "A2", "A3", "A4", "A5"]
    },
    "may_subdelegate": {
      "type": "boolean"
    },
    "revocation_path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "expired", "revoked", "completed"]
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by_delegation_id": {
      "type": "string",
      "minLength": 8,
      "description": "Set when this delegation was revoked as part of an AEC-13 cascade rather than directly."
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "overlay_context": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
