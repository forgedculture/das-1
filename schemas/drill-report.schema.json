{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgedculture.org/das-1/schemas/drill-report.schema.json",
  "title": "DAS-1 Drill Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "drill_id",
    "run_id",
    "executed_at",
    "environment",
    "owner_id",
    "result",
    "evidence_refs"
  ],
  "properties": {
    "report_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "drill_id": {
      "type": "string",
      "pattern": "^D(?:[1-9][0-9]*|-[A-Z0-9]+(?:-[A-Z0-9]+)*)$"
    },
    "run_id": {
      "type": "string",
      "minLength": 8
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "witness_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "workflow_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "scorecard_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "revocation_within_budget": {
      "type": "boolean"
    },
    "chain_reconstruction_ok": {
      "type": "boolean"
    },
    "audit_completeness_preserved": {
      "type": "boolean"
    },
    "m1_time_to_revoke_ms_p95": {
      "type": "number",
      "minimum": 0
    },
    "m2_approval_latency_ms_p95": {
      "type": "number",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    },
    "remediation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "overlay_context": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
