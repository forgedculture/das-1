{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgedculture.org/das-1/schemas/ir-annex.schema.json",
  "title": "DAS-1 Tool-Call Incident Response Annex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex_version",
    "annex_id",
    "generated_at",
    "owner_id",
    "detection",
    "containment",
    "evidence_capture",
    "decision_trace_reconstruction",
    "tabletop"
  ],
  "properties": {
    "annex_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "annex_id": {
      "type": "string",
      "minLength": 8
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signals",
        "pager_route"
      ],
      "properties": {
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "pager_route": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revocation_procedure",
        "isolation_procedure"
      ],
      "properties": {
        "revocation_procedure": {
          "type": "string",
          "minLength": 1
        },
        "isolation_procedure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_sources",
        "forensics_storage"
      ],
      "properties": {
        "receipt_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forensics_storage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_trace_reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedure",
        "owner_id"
      ],
      "properties": {
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tabletop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_executed_at",
        "exercise_ref"
      ],
      "properties": {
        "last_executed_at": {
          "type": "string",
          "format": "date-time"
        },
        "exercise_ref": {
          "type": "string",
          "minLength": 1
        },
        "remediation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
